# Copiar a .env (no se sube a git). deploy_prod.sh lo crea solo en el servidor.

# --- LinkStack (/social): solo se usan en el primer arranque ---
LINKSTACK_ADMIN_EMAIL=spaceteam@uma.es
LINKSTACK_ADMIN_PASSWORD=
# true solo si hay un proxy delante que no envía X-Forwarded-Proto: https
LINKSTACK_FORCE_HTTPS=false

# --- Solo producción (docker-compose.prod.yml) ---
JWT_SECRET=
