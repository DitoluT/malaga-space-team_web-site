---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';

import Section from './Section.astro';
import Subsystems from './Subsystems.astro';
import TeamMembers from './TeamMembers.astro';
import Partners from './Partners.astro';
import Collaborators from './Collaborators.astro';
import ContactSection from './ContactSection.astro';
import { eyebrow } from './styles';

import { CONTACT, getDictionary, route } from '~/i18n';
import type { Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);

const metadata = {
  title: t.meta.title,
  ignoreTitleTemplate: true,
  description: t.meta.description,
};

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Málaga Space Team',
  url: 'https://spaceteam.uma.es',
  logo: new URL('/favicon.png', Astro.site).href,
  description: t.meta.description,
  email: CONTACT.email,
  address: { '@type': 'PostalAddress', addressLocality: 'Málaga', postalCode: '29071', addressCountry: 'ES' },
  parentOrganization: { '@type': 'CollegeOrUniversity', name: 'Universidad de Málaga', url: 'https://www.uma.es' },
  sameAs: [CONTACT.linkedin, CONTACT.instagram],
};

const stats = [
  { amount: '30+', title: t.stats.teamMembers, description: t.stats.teamMembersDesc },
  { amount: '+10', title: t.extra.stats.degrees, description: t.extra.stats.degreesDesc },
];

const mission = [
  t.mission.technologicalInnovation,
  t.mission.educationalExcellence,
  t.mission.collaborativeResearch,
  t.mission.globalImpact,
];

const benefits = [
  t.team.benefits.practicalExperience,
  t.team.benefits.interdisciplinaryCollaboration,
  t.team.benefits.technologicalInnovation,
];
---

<Layout metadata={metadata} lang={lang} page="home">
  <StructuredData slot="head" schema={organization} />

  <!-- Portada -->
  <section id="inicio">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="py-20 md:py-32">
        <p class={eyebrow}>{t.hero.university}</p>
        <h1
          class="mt-6 max-w-4xl text-4xl font-bold leading-[1.05] tracking-tight text-heading sm:text-5xl md:text-7xl"
        >
          {t.extra.heroTitle}{' '}
          <span class="text-muted">{t.extra.heroTitleMuted}</span>
        </h1>
        <p class="mt-8 max-w-2xl text-lg text-muted md:text-xl">{t.hero.description}</p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <a href="#acerca" class="btn-primary">{t.hero.primaryButton}</a>
          <a href={route('join', lang)} class="btn">{t.hero.secondaryButton}</a>
        </div>
      </div>

      <!-- Cifras -->
      <dl class="grid border-t border-strong sm:grid-cols-2">
        {
          stats.map((stat) => (
            <div class="border-b border-line py-8 sm:border-b-0 sm:border-r sm:px-8 sm:first:pl-0 sm:last:border-r-0">
              <dd class="text-5xl font-bold tracking-tight text-heading tabular-nums md:text-6xl">{stat.amount}</dd>
              <dt class="mt-2 font-semibold text-heading">{stat.title}</dt>
              <p class="text-sm text-muted">{stat.description}</p>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Misión -->
  <Section id="acerca" title={t.mission.title} subtitle={t.mission.description} divider={false}>
    <ol class="grid gap-x-12 gap-y-10 md:grid-cols-2">
      {
        mission.map((item, index) => (
          <li class="border-t border-strong pt-4">
            <span class="text-sm font-semibold text-muted tabular-nums">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-2 text-xl font-bold text-heading">{item.title}</h3>
            <p class="mt-2 text-muted">{item.description}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Subsistemas -->
  <Subsystems t={t} />

  <!-- Equipo -->
  <Section id="equipo" title={t.team.title} subtitle={t.team.description}>
    <TeamMembers t={t}>
      <h3 class="text-2xl font-bold tracking-tight text-heading">{t.extra.teamLive.title}</h3>
      <p class="mt-2 mb-10 text-muted">{t.extra.teamLive.description}</p>
    </TeamMembers>
    <p class="mt-8">
      <a href={route('alumni', lang)} class="text-sm font-semibold text-heading underline-offset-4 hover:underline">
        {t.extra.teamLive.alumniLink} →
      </a>
    </p>

    <div class="mt-16 grid gap-12 lg:grid-cols-2">
      <div>
        <p class={eyebrow}>{t.team.joinTeam.title}</p>
        <h3 class="mt-3 text-2xl font-bold tracking-tight text-heading md:text-3xl">{t.team.joinTeam.subtitle}</h3>
        <p class="mt-4 text-muted">{t.team.joinTeam.description}</p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {
            t.team.disciplines.map((discipline: string) => (
              <li class="rounded-md border border-line px-3 py-1 text-sm text-muted">{discipline}</li>
            ))
          }
        </ul>
      </div>
      <dl class="space-y-6">
        {
          benefits.map((benefit) => (
            <div class="border-t border-strong pt-4">
              <dt class="font-bold text-heading">{benefit.title}</dt>
              <dd class="mt-1 text-sm text-muted">{benefit.description}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <!-- Llamada a unirse -->
    <div class="mt-16 rounded-md border border-strong p-8 md:flex md:items-center md:justify-between md:gap-10 md:p-12">
      <div class="max-w-2xl">
        <h3 class="text-2xl font-bold tracking-tight text-heading md:text-3xl">{t.team.joinTeam.callToAction}</h3>
        <p class="mt-3 text-muted">{t.team.joinTeam.callToActionDescription}</p>
      </div>
      <a href={route('join', lang)} class="btn-primary mt-8 shrink-0 md:mt-0">{t.navigation.joinTeam}</a>
    </div>
  </Section>

  <!-- Partners (solo si hay en /admin) y colaboradores -->
  <Partners t={t} />
  <Collaborators t={t} />

  <!-- Contacto -->
  <ContactSection t={t} />
</Layout>
