---
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import { cardInteractive, eyebrow } from './styles';
import type { Dictionary } from '~/i18n';

export interface Props {
  t: Dictionary;
  id?: string;
}

const { t, id = 'subsistemas' } = Astro.props;

const icons: Record<string, string> = {
  structure: 'tabler:box-multiple',
  power: 'tabler:battery-charging',
  adcs: 'tabler:compass',
  cdhs: 'tabler:cpu',
  payload: 'tabler:hierarchy-2',
  communications: 'tabler:antenna',
};

const items = Object.entries(t.subsystems.items);
const modal = t.subsystems.modal;
---

<Section id={id} title={t.subsystems.title} subtitle={t.subsystems.description}>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      items.map(([key, item]) => (
        <button
          type="button"
          class:list={[cardInteractive, 'group p-6 text-left']}
          data-subsystem-open={key}
          aria-haspopup="dialog"
        >
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-xl font-bold text-heading">{item.title}</h3>
            <Icon name={icons[key] ?? 'tabler:satellite'} class="h-6 w-6 text-muted group-hover:text-heading" />
          </div>
          <p class="mt-4 text-muted">{item.description}</p>
          <span class="mt-6 inline-block text-sm font-semibold text-heading underline-offset-4 group-hover:underline">
            {t.subsystems.viewDetails}
          </span>
        </button>
      ))
    }
  </div>

  {
    items.map(([key, item]) => (
      <dialog
        data-subsystem-dialog={key}
        aria-labelledby={`subsystem-${key}-title`}
        class="m-auto w-[min(92vw,44rem)] max-h-[88vh] overflow-y-auto rounded-md border border-strong bg-page p-0 text-default backdrop:bg-black/80"
      >
        <div class="p-6 md:p-8">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class={eyebrow}>{t.subsystems.title}</p>
              <h3 id={`subsystem-${key}-title`} class="mt-1 text-2xl font-bold text-heading">
                {item.title}
              </h3>
            </div>
            <button
              type="button"
              data-subsystem-close
              aria-label={modal.close}
              class="rounded-md p-2 text-muted hover:text-heading"
            >
              <Icon name="tabler:x" class="h-5 w-5" />
            </button>
          </div>

          <p class="mt-4 text-muted">{item.description}</p>

          <div class="mt-6 grid gap-6 md:grid-cols-2">
            <div>
              <h4 class="mb-2 font-semibold text-heading">{modal.components}</h4>
              <ul class="space-y-1 text-sm text-muted">
                {item.components.map((c: string) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="text-muted">
                      —
                    </span>
                    {c}
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h4 class="mb-2 font-semibold text-heading">{modal.specifications}</h4>
              <ul class="space-y-1 text-sm text-muted">
                {item.specifications.map((s: string) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="text-muted">
                      —
                    </span>
                    {s}
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="mt-6 rounded-md border border-line p-4">
            <h4 class="mb-1 font-semibold text-heading">{modal.status}</h4>
            <p class="text-sm text-muted">{item.status}</p>
          </div>

          <div class="mt-6">
            <h4 class="mb-2 font-semibold text-heading">{modal.challenges}</h4>
            <ul class="space-y-1 text-sm text-muted">
              {item.challenges.map((c: string) => (
                <li class="flex gap-2">
                  <span aria-hidden="true" class="text-muted">
                    —
                  </span>
                  {c}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </dialog>
    ))
  }
</Section>

<script>
  import { onPageLoad } from '~/scripts/live';

  onPageLoad(() => {
    document.querySelectorAll<HTMLElement>('[data-subsystem-open]').forEach((button) => {
      button.addEventListener('click', () => {
        const dialog = document.querySelector<HTMLDialogElement>(
          `dialog[data-subsystem-dialog="${button.dataset.subsystemOpen}"]`
        );
        dialog?.showModal();
      });
    });

    document.querySelectorAll<HTMLDialogElement>('dialog[data-subsystem-dialog]').forEach((dialog) => {
      dialog.querySelector('[data-subsystem-close]')?.addEventListener('click', () => dialog.close());
      // Clic en el fondo (fuera del contenido) cierra la ficha
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    });
  });
</script>
